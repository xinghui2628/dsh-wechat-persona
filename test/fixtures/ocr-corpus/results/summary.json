 "v3Pipeline": {
  "implementedIn": "scripts/ocr/v3-pipeline.mjs",
  "configs": [
   {
    "id": "novote",
    "label": "WinRT 2x + 归一 + 受控纠错（不用第二引擎）",
    "useVote": "none"
   },
   {
    "id": "vote-garbled",
    "label": "v3 真实等价：可疑消息才用 RapidOCR 同帧投票",
    "useVote": "garbled"
   },
   {
    "id": "vote-all",
    "label": "上界参考（非真实可在线）：所有消息都用 RapidOCR 投票",
    "useVote": "all"
   }
  ],
  "notices": [
   "离线等价按消息粒度实现：winrt 2x 分组文本 → 归一化 → （可疑时）RapidOCR 同帧按 |y-top|≤26 + 重合度≥0.35 + 更长才替换 → mergeEngineVote/pickBetterText → 受控纠错。",
   "真实管线在首读可疑时会再换 4x/2x 帧重读；bench 无 4x 变体，本实现只等价到 2x 首读，偏保守。",
   "消息分组用 GT bbox 近似（与 baseline A/B 同口径）；真实 pipeline 按 UI 坐标分组。",
   "真实 recheckGarbledText 作用于整段聊天文本；这里按消息粒度做等价投票。",
   "气泡归属用「行框并集 + 内边距」近似 bubble bbox，pane 取整图宽度（真实由脚本提供 pane 几何）。"
  ]
 },
 "notes": [
  "CER = 字符级 Levenshtein / GT 字符数（消息级聚合：Σ edit / Σ GT chars），比较前去空白。",
  "行级 P/R/F1：归一化文本相似度 + IoU 辅助一对一匹配；重复行单独计数并从 TP 之外计。",
  "假消息率 = 未匹配且非重复的 OCR 行 / OCR 内容行；窗口 chrome（标题/输入框/时间戳）按 manifest.expectedContext 豁免。",
  "P50/P95 为引擎自报的 OCR 耗时（不含进程启动/模型加载），RapidOCR 模型加载时间见各 run 的 meta.modelLoadMs。",
  "baseline 组：分组用 GT bbox 近似，仅衡量「同一批原始行经过 v0.2.8 后处理」的增益，不代表真实 pipeline 的定位能力。",
  "v3 组：离线等价（winrt 2x 首读 → 归一 → 可疑消息 RapidOCR 同帧投票 → 受控纠错），无 4x 帧重读；分组同为 GT bbox 近似。"
 ]
}